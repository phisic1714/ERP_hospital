// Prisma Schema for Hospital Inventory Management System (HIMS)
// Default provider: sqlite for zero-configuration, zero-dependency local execution
// Can be switched to postgresql by setting provider = "postgresql" and DATABASE_URL in .env

generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// USER & PERMISSION (RBAC)
// -------------------------------------------------------------
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  name         String
  email        String    @unique
  passwordHash String
  role         String    // ADMIN, INVENTORY_MGR, WAREHOUSE_OFFICER, STOCK_CONTROLLER, DEPT_REQUESTER, DEPT_APPROVER, PROCUREMENT, AUDITOR
  departmentId String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id])
}

model Department {
  id            String    @id @default(cuid())
  code          String    @unique // OPD, IPD, ER, OR, LAB, PHARM, RAD, etc.
  name          String
  location      String?
  contactPerson String?
  phone         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users         User[]
  warehouses    Warehouse[]
  stockIssues   StockIssue[]
  stockReturns  StockReturn[]
  requisitions  PurchaseRequisition[]
}

// -------------------------------------------------------------
// MASTER DATA
// -------------------------------------------------------------
model ItemCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   // Medicine (ยา), Medical Supplies (เวชภัณฑ์), General Supplies (วัสดุทั่วไป)
  description String?
  active      Boolean  @default(true)
  items       Item[]
}

model Item {
  id              String   @id @default(cuid())
  itemCode        String   @unique
  itemName        String
  genericName     String?
  categoryId      String
  subCategory     String?
  description     String?
  unit            String   // Main Unit e.g., Box, Piece, Bottle, Pack
  purchaseUnit    String?  // e.g., Box
  issueUnit       String?  // e.g., Piece
  conversionRate  Float?   @default(1.0) // 1 PurchaseUnit = conversionRate IssueUnit
  barcode         String?
  minStock        Float    @default(0)
  maxStock        Float    @default(0)
  reorderPoint    Float    @default(0)
  safetyStock     Float    @default(0)
  standardCost    Float    @default(0.0)
  lotControl      Boolean  @default(true)
  expiryControl   Boolean  @default(true)
  serialControl   Boolean  @default(false)
  temperatureReq  String?  // e.g., Room Temp (20-25C), Cold Chain (2-8C)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        ItemCategory            @relation(fields: [categoryId], references: [id])
  unitConversions UnitConversion[]
  lots            Lot[]
  stockBalances   StockBalance[]
  stockMovements  StockMovement[]
  poLines         ProcurementPOLine[]
  grLines         GoodsReceiptLine[]
  issueLines      StockIssueLine[]
  transferLines   StockTransferLine[]
  returnLines     StockReturnLine[]
  adjustmentLines StockAdjustmentLine[]
  countLines      StockCountLine[]
  planLines       ProcurementPlanLine[]
  prLines         PurchaseRequisitionLine[]
  rfqLines        RFQLine[]
  quotationLines  QuotationLine[]
}

model UnitConversion {
  id             String  @id @default(cuid())
  itemId         String
  fromUnit       String  // e.g. Box
  toUnit         String  // e.g. Pack
  conversionRate Float   // e.g. 10.0 (1 Box = 10 Packs)

  item           Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  taxId         String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  paymentTerm   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders ProcurementPO[]
  goodsReceipts  GoodsReceipt[]
  returns        StockReturn[]
  rfqInvites     RFQSupplier[]
  quotations     Quotation[]
}

model Warehouse {
  id             String    @id @default(cuid())
  code           String    @unique // MAIN, OPD, IPD, ER, OR, LAB
  name           String
  type           String    // MAIN, DEPARTMENT, QUARANTINE, DAMAGED
  departmentId   String?
  managerName    String?
  location       String?
  storageCond    String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  department     Department?         @relation(fields: [departmentId], references: [id])
  locations      WarehouseLocation[]
  lots           Lot[]
  stockBalances  StockBalance[]
  goodsReceipts  GoodsReceipt[]
  stockIssues    StockIssue[]        @relation("SourceWarehouse")
  stockTransfersSource StockTransfer[] @relation("TransferSource")
  stockTransfersDest   StockTransfer[] @relation("TransferDest")
  stockReturns   StockReturn[]
  stockAdjustments StockAdjustment[]
  stockCounts    StockCount[]
}

model WarehouseLocation {
  id          String   @id @default(cuid())
  warehouseId String
  code        String   // e.g. WH01-ZA-R01-S01-B01
  zone        String   // Zone A, Zone B, etc.
  rack        String?  // R01
  shelf       String?  // S01
  bin         String?  // B01
  active      Boolean  @default(true)

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lots        Lot[]
}

// -------------------------------------------------------------
// INVENTORY & LOTS
// -------------------------------------------------------------
model Lot {
  id            String    @id @default(cuid())
  itemId        String
  warehouseId   String
  locationId    String?
  lotNumber     String
  expiryDate    DateTime
  receivedDate  DateTime  @default(now())
  initialQty    Float
  currentQty    Float
  reservedQty   Float     @default(0.0)
  quarantineQty Float     @default(0.0)
  damagedQty    Float     @default(0.0)
  expiredQty    Float     @default(0.0)
  unitCost      Float     @default(0.0)
  status        String    @default("ACTIVE") // ACTIVE, QUARANTINE, EXPIRED, DEPLETED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  item          Item               @relation(fields: [itemId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  location      WarehouseLocation? @relation(fields: [locationId], references: [id])
}

model StockBalance {
  id             String    @id @default(cuid())
  itemId         String
  warehouseId    String
  onHand         Float     @default(0.0)
  reserved       Float     @default(0.0)
  available      Float     @default(0.0) // onHand - reserved - quarantine - damaged - expired
  inTransit      Float     @default(0.0)
  quarantine     Float     @default(0.0)
  damaged        Float     @default(0.0)
  expired        Float     @default(0.0)
  lastMovementAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  item           Item      @relation(fields: [itemId], references: [id])
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([itemId, warehouseId])
}

model StockMovement {
  id             String    @id @default(cuid())
  movementNumber String    @unique
  movementType   String    // RECEIVE, ISSUE_DIRECT, TRANSFER_DISPATCH, TRANSFER_RECEIVE, RETURN_DEPT, RETURN_SUPPLIER, ADJUSTMENT, COUNT_ADJUST
  documentType   String    // GR, ISSUE, TRANSFER, RETURN, ADJUSTMENT, COUNT
  documentNumber String
  itemId         String
  warehouseId    String
  fromWarehouseId String?
  toWarehouseId   String?
  lotId          String?
  lotNumber      String?
  quantity       Float
  balanceBefore  Float     @default(0.0)
  balanceAfter   Float     @default(0.0)
  unitCost       Float     @default(0.0)
  totalCost      Float     @default(0.0)
  remark         String?
  createdBy      String
  createdAt      DateTime  @default(now())

  item           Item      @relation(fields: [itemId], references: [id])
}

// -------------------------------------------------------------
// PROCUREMENT & SOURCING (PP & PR)
// -------------------------------------------------------------

// Procurement Plan (PP) - แผนการจัดซื้อจัดจ้างและกรอบงบประมาณ
model ProcurementPlan {
  id              String    @id @default(cuid())
  planNumber      String    @unique // PP-YYYY-XXXX
  fiscalYear      Int       // e.g. 2569 / 2026
  name            String
  categoryCode    String    @default("ALL") // MED, SUPPLY, GEN, ALL
  departmentId    String?
  allocatedBudget Float     @default(0.0)
  committedBudget Float     @default(0.0)
  remainingBudget Float     @default(0.0)
  status          String    @default("ACTIVE") // DRAFT, PENDING_APPROVAL, APPROVED, ACTIVE, CLOSED, REJECTED
  startDate       DateTime?
  endDate         DateTime?
  remarks         String?
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines           ProcurementPlanLine[]
  requisitions    PurchaseRequisition[]
}

model ProcurementPlanLine {
  id                 String   @id @default(cuid())
  planId             String
  itemId             String
  targetQuantity     Float
  estimatedUnitPrice Float    @default(0.0)
  estimatedTotal     Float    @default(0.0)
  usedQuantity       Float    @default(0.0)
  usedBudget         Float    @default(0.0)

  plan               ProcurementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  item               Item            @relation(fields: [itemId], references: [id])
}

// Purchase Requisition (PR) - ใบขอซื้อพัสดุและยา
model PurchaseRequisition {
  id              String    @id @default(cuid())
  prNumber        String    @unique // PR-YYYYMM-XXXX
  planId          String?
  departmentId    String?
  warehouseId     String?
  requestDate     DateTime  @default(now())
  requiredDate    DateTime?
  urgency         String    @default("NORMAL") // NORMAL, URGENT, EMERGENCY
  purchaseType    String    @default("GENERAL") // GENERAL, MEDICAL_SUPPLY, DRUG, EQUIPMENT
  budgetYear      Int?      // e.g. 2569
  isUnplanned     Boolean   @default(false)
  unplannedReason String?
  attachmentName  String?
  attachmentUrl   String?
  totalAmount     Float     @default(0.0)
  status          String    @default("PENDING_APPROVAL") // DRAFT, PENDING_APPROVAL, APPROVED, RETURNED, REJECTED, PO_CREATED, CANCELLED
  justification   String?
  requesterName   String
  approvedBy      String?
  approvedAt      DateTime?
  rejectReason    String?
  returnReason    String?
  returnedBy      String?
  returnedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  plan            ProcurementPlan?         @relation(fields: [planId], references: [id])
  department      Department?              @relation(fields: [departmentId], references: [id])
  lines           PurchaseRequisitionLine[]
  purchaseOrders  ProcurementPO[]
  rfqs            RFQ[]
}

model PurchaseRequisitionLine {
  id                 String   @id @default(cuid())
  prId               String
  itemId             String
  specification      String?
  remark             String?
  currentStock       Float    @default(0.0)
  reorderPoint       Float    @default(0.0)
  requestedQty       Float
  approvedQty        Float    @default(0.0)
  orderedQty         Float    @default(0.0)
  estimatedUnitPrice Float    @default(0.0)
  estimatedTotal     Float    @default(0.0)
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED

  requisition        PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  item               Item                @relation(fields: [itemId], references: [id])
}

// -------------------------------------------------------------
// SOURCING (RFQ -> QUOTATION -> COMPARISON / AWARD)
// -------------------------------------------------------------

// Request for Quotation (RFQ) - ขอใบเสนอราคา
model RFQ {
  id                  String    @id @default(cuid())
  rfqNumber           String    @unique // RFQ-YYYYMM-XXXX
  prId                String?
  prNumber            String?
  title               String
  issueDate           DateTime  @default(now())
  dueDate             DateTime?
  status              String    @default("DRAFT") // DRAFT, SENT, QUOTING, AWARDED, PO_CREATED, CANCELLED
  remarks             String?
  createdBy           String
  // Comparison / award result
  selectedQuotationId String?
  selectionCriteria   String?   // LOWEST_PRICE, BEST_VALUE, FASTEST_DELIVERY, QUALITY
  selectionReason     String?
  comparedBy          String?
  comparedAt          DateTime?
  poId                String?
  poNumber            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requisition         PurchaseRequisition? @relation(fields: [prId], references: [id])
  lines               RFQLine[]
  suppliers           RFQSupplier[]
  quotations          Quotation[]
  purchaseOrders      ProcurementPO[]
}

model RFQLine {
  id                 String  @id @default(cuid())
  rfqId              String
  itemId             String
  quantity           Float
  estimatedUnitPrice Float   @default(0.0)
  specification      String?

  rfq                RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  item               Item            @relation(fields: [itemId], references: [id])
  quotationLines     QuotationLine[]
}

model RFQSupplier {
  id          String   @id @default(cuid())
  rfqId       String
  supplierId  String
  status      String   @default("INVITED") // INVITED, RESPONDED, DECLINED
  invitedAt   DateTime @default(now())

  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id])

  @@unique([rfqId, supplierId])
}

// Quotation - ใบเสนอราคาจากผู้จำหน่าย
model Quotation {
  id                String    @id @default(cuid())
  quotationNumber   String    @unique // QT-YYYYMM-XXXX
  supplierQuoteRef  String?   // เลขที่ใบเสนอราคาของผู้จำหน่าย
  rfqId             String
  supplierId        String
  quoteDate         DateTime  @default(now())
  validUntil        DateTime?
  deliveryDays      Int       @default(7)
  paymentTerm       String?
  warranty          String?
  qualityScore      Float     @default(0.0) // 0-5
  totalAmount       Float     @default(0.0)
  status            String    @default("RECEIVED") // RECEIVED, SELECTED, NOT_SELECTED, CANCELLED
  remarks           String?
  attachmentName    String?   // ชื่อไฟล์ใบเสนอราคาต้นฉบับ
  attachmentUrl     String?   // ลิงก์ / URL เอกสารแนบ
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  rfq               RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier          Supplier        @relation(fields: [supplierId], references: [id])
  lines             QuotationLine[]
  purchaseOrders    ProcurementPO[]
}

model QuotationLine {
  id           String   @id @default(cuid())
  quotationId  String
  rfqLineId    String?
  itemId       String
  quantity     Float
  unitPrice    Float    @default(0.0)
  totalAmount  Float    @default(0.0)
  brand        String?
  remark       String?

  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqLine      RFQLine?  @relation(fields: [rfqLineId], references: [id])
  item         Item      @relation(fields: [itemId], references: [id])
}

// -------------------------------------------------------------
// TRANSACTIONS
// -------------------------------------------------------------

// Procurement PO Integration
model ProcurementPO {
  id               String    @id @default(cuid())
  poNumber         String    @unique // PO-YYYYMM-XXXX
  prId             String?
  prNumber         String?
  rfqId            String?
  rfqNumber        String?
  quotationId      String?
  quotationNumber  String?
  supplierQuoteRef String?
  supplierId       String
  orderDate        DateTime
  expectedDate     DateTime?
  deliveryLocation String?   @default("คลังยาและเวชภัณฑ์กลาง อาคารเภสัชกรรม ชั้น 1")
  paymentTerms     String?   @default("Credit 30 วัน")
  creditDays       Int?      @default(30)
  budgetReference  String?
  subtotal         Float     @default(0.0)
  discount         Float     @default(0.0)
  taxRate          Float     @default(7.0)
  vatAmount        Float     @default(0.0)
  netAmount        Float     @default(0.0)
  totalAmount      Float     @default(0.0)
  status           String    @default("PENDING_APPROVAL") // DRAFT, PENDING_APPROVAL, APPROVED, ORDERED, PARTIALLY_RECEIVED, FULLY_RECEIVED, CLOSED, REJECTED, CANCELLED
  remarks          String?
  attachmentName   String?
  attachmentUrl    String?
  revision         Int       @default(1)
  createdBy        String
  approvedBy       String?
  approvedAt       DateTime?
  sentToSupplierAt DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  supplier         Supplier              @relation(fields: [supplierId], references: [id])
  requisition      PurchaseRequisition?  @relation(fields: [prId], references: [id])
  rfq              RFQ?                  @relation(fields: [rfqId], references: [id])
  quotation        Quotation?            @relation(fields: [quotationId], references: [id])
  lines            ProcurementPOLine[]
  goodsReceipts    GoodsReceipt[]
}

model ProcurementPOLine {
  id            String    @id @default(cuid())
  poId          String
  itemId        String
  prLineId      String?
  specification String?
  orderedQty    Float
  receivedQty   Float     @default(0.0)
  remainingQty  Float
  unitPrice     Float     @default(0.0)
  discount      Float     @default(0.0)
  taxRate       Float     @default(7.0)
  vatAmount     Float     @default(0.0)
  netAmount     Float     @default(0.0)
  totalAmount   Float     @default(0.0)
  expectedDate  DateTime?
  remark        String?
  status        String    @default("PENDING") // PENDING, PARTIAL, COMPLETED

  po            ProcurementPO @relation(fields: [poId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
}

// Goods Receiving (GR)
model GoodsReceipt {
  id              String    @id @default(cuid())
  grNumber        String    @unique // GR-YYYYMM-XXXX
  poId            String?
  poNumber        String?
  supplierId      String
  warehouseId     String
  receivingDate   DateTime  @default(now())
  status          String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, INSPECTION, POSTED, REJECTED
  inspectionNotes String?
  totalAccepted   Float     @default(0.0)
  totalRejected   Float     @default(0.0)
  totalQuarantine Float     @default(0.0)
  remark          String?
  createdBy       String
  postedBy        String?
  postedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  po              ProcurementPO?     @relation(fields: [poId], references: [id])
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  lines           GoodsReceiptLine[]
}

model GoodsReceiptLine {
  id                 String   @id @default(cuid())
  grId               String
  poLineId           String?
  itemId             String
  orderedQty         Float    @default(0.0)
  previouslyReceived Float    @default(0.0)
  remainingQty       Float    @default(0.0)
  receivedQty        Float
  acceptedQty        Float    @default(0.0)
  rejectedQty        Float    @default(0.0)
  quarantineQty      Float    @default(0.0)
  lotNumber          String
  expiryDate         DateTime
  unitPrice          Float    @default(0.0)
  locationId         String?
  remark             String?

  gr                 GoodsReceipt @relation(fields: [grId], references: [id], onDelete: Cascade)
  item               Item         @relation(fields: [itemId], references: [id])
}

// Stock Issue
model StockIssue {
  id                     String    @id @default(cuid())
  issueNumber            String    @unique // ISS-YYYYMM-XXXX
  issueType              String    @default("DIRECT") // DIRECT, REPLENISHMENT
  requesterId            String?
  requesterName          String
  departmentId           String
  sourceWarehouseId      String
  destinationWarehouseId String?
  requestDate            DateTime  @default(now())
  requiredDate           DateTime?
  status                 String    @default("PENDING_APPROVAL") // DRAFT, PENDING_APPROVAL, APPROVED, PARTIALLY_ISSUED, POSTED, REJECTED, CANCELLED
  approvalNotes          String?
  remark                 String?
  createdBy              String
  approvedBy             String?
  approvedAt             DateTime?
  postedBy               String?
  postedAt               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  department             Department       @relation(fields: [departmentId], references: [id])
  sourceWarehouse        Warehouse        @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  lines                  StockIssueLine[]
}

model StockIssueLine {
  id           String  @id @default(cuid())
  issueId      String
  itemId       String
  requestedQty Float
  approvedQty  Float   @default(0.0)
  issuedQty    Float   @default(0.0)
  lotId        String?
  lotNumber    String?
  unit         String
  remark       String?

  issue        StockIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  item         Item       @relation(fields: [itemId], references: [id])
}

// Stock Transfer
model StockTransfer {
  id                     String    @id @default(cuid())
  transferNumber         String    @unique // TRF-YYYYMM-XXXX
  sourceWarehouseId      String
  destinationWarehouseId String
  transferDate           DateTime  @default(now())
  status                 String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, DISPATCHED, IN_TRANSIT, RECEIVED, COMPLETED, CANCELLED
  dispatchNotes          String?
  receivingNotes         String?
  discrepancyNotes       String?
  remark                 String?
  createdBy              String
  approvedBy             String?
  dispatchedBy           String?
  dispatchedAt           DateTime?
  receivedBy             String?
  receivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sourceWarehouse        Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destWarehouse          Warehouse           @relation("TransferDest", fields: [destinationWarehouseId], references: [id])
  lines                  StockTransferLine[]
}

model StockTransferLine {
  id             String  @id @default(cuid())
  transferId     String
  itemId         String
  requestedQty   Float
  dispatchedQty  Float   @default(0.0)
  receivedQty    Float   @default(0.0)
  lotId          String?
  lotNumber      String?
  discrepancyQty Float   @default(0.0)
  remark         String?

  transfer       StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item           Item          @relation(fields: [itemId], references: [id])
}

// Stock Return
model StockReturn {
  id                     String    @id @default(cuid())
  returnNumber           String    @unique // RET-YYYYMM-XXXX
  returnType             String    // DEPT_RETURN, SUPPLIER_RETURN
  departmentId           String?
  supplierId             String?
  warehouseId            String
  originalDocumentNumber String?
  returnDate             DateTime  @default(now())
  status                 String    @default("PENDING_INSPECTION") // DRAFT, PENDING_INSPECTION, INSPECTED, POSTED, REJECTED
  inspectionResult       String?
  reason                 String?
  createdBy              String
  postedBy               String?
  postedAt               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  department             Department?       @relation(fields: [departmentId], references: [id])
  supplier               Supplier?         @relation(fields: [supplierId], references: [id])
  warehouse              Warehouse         @relation(fields: [warehouseId], references: [id])
  lines                  StockReturnLine[]
}

model StockReturnLine {
  id          String  @id @default(cuid())
  returnId    String
  itemId      String
  lotId       String?
  lotNumber   String?
  returnQty   Float
  acceptedQty Float   @default(0.0)
  rejectedQty Float   @default(0.0)
  condition   String? // GOOD, DAMAGED, EXPIRED
  reason      String?
  remark      String?

  stockReturn StockReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id])
}

// Stock Adjustment
model StockAdjustment {
  id               String    @id @default(cuid())
  adjustmentNumber String    @unique // ADJ-YYYYMM-XXXX
  warehouseId      String
  adjustmentType   String    // INCREASE, DECREASE, DAMAGED, EXPIRED, LOST, CORRECTION
  status           String    @default("PENDING_APPROVAL") // DRAFT, PENDING_APPROVAL, APPROVED, POSTED, REJECTED
  reason           String
  requestedBy      String
  approvedBy       String?
  approvedAt       DateTime?
  postedBy         String?
  postedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id])
  lines            StockAdjustmentLine[]
}

model StockAdjustmentLine {
  id            String  @id @default(cuid())
  adjustmentId  String
  itemId        String
  lotId         String?
  lotNumber     String?
  currentQty    Float
  adjustmentQty Float   // Positive for Increase, Negative for Decrease
  newQty        Float
  unitCost      Float   @default(0.0)
  reason        String?

  adjustment    StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item          Item            @relation(fields: [itemId], references: [id])
}

// Stock Count
model StockCount {
  id            String    @id @default(cuid())
  countNumber   String    @unique // CNT-YYYYMM-XXXX
  warehouseId   String
  countPlanName String
  isBlindCount  Boolean   @default(false)
  countDate     DateTime  @default(now())
  status        String    @default("DRAFT") // DRAFT, IN_PROGRESS, COUNTED, PENDING_APPROVAL, APPROVED, CLOSED, CANCELLED
  counterName   String
  remark        String?
  createdBy     String
  approvedBy    String?
  approvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  lines         StockCountLine[]
}

model StockCountLine {
  id                 String  @id @default(cuid())
  countId            String
  itemId             String
  lotId              String?
  lotNumber          String?
  systemQty          Float
  countedQty         Float   @default(0.0)
  varianceQty        Float   @default(0.0)
  variancePercentage Float   @default(0.0)
  recountRequired    Boolean @default(false)
  recountQty         Float?
  notes              String?

  count              StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item               Item       @relation(fields: [itemId], references: [id])
}

// Approval Center & History
model ApprovalTransaction {
  id             String   @id @default(cuid())
  documentType   String   // GR, ISSUE, TRANSFER, RETURN, ADJUSTMENT, COUNT
  documentId     String
  documentNumber String
  roleRequired   String
  approverName   String
  action         String   // APPROVED, REJECTED, RETURN_FOR_REVISION
  comment        String?
  createdAt      DateTime @default(now())
}

// Document Sequence Generator (atomic)
model DocumentSequence {
  id              String @id @default(cuid())
  prefix          String // GR, ISS, TRF, RET, ADJ, CNT, PO
  yearMonth       String // YYYYMM e.g., 202610
  currentSequence Int    @default(0)

  @@unique([prefix, yearMonth])
}

// Audit Trail
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String   // CREATE, UPDATE, APPROVE, REJECT, POST, DISPATCH, RECEIVE, CANCEL
  module    String   // ITEM, WAREHOUSE, GR, ISSUE, TRANSFER, RETURN, ADJUSTMENT, COUNT, AUTH
  recordId  String?
  details   String?
  timestamp DateTime @default(now())
}
